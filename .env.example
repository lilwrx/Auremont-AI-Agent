# Copy this file to .env and fill in your values. Never commit .env to git.

# ---- App Configuration ----
APP_NAME=AI20K Project
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
BUSINESS_TIMEZONE=Asia/Bangkok
LOG_LEVEL=INFO
LOG_JSON=true
LOG_QUERY_TEXT=true
HEALTH_CHECK_TIMEOUT_SECONDS=3

# ---- Authentication ----
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database ----
DATABASE_URL=

# ---- Infrastructure services ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=salesmate_documents
REDIS_URL=redis://localhost:6379/0
MEMORY_TTL_SECONDS=7776000
SEARCH_CRITERIA_ENABLED=true
SEARCH_CRITERIA_TTL_SECONDS=86400

# Set false for the local HTTP MinIO service.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=true
MINIO_BUCKET_DOCUMENTS=salesmate-documents
MINIO_BUCKET_PROJECT_IMAGES=project-images
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ---- Gemini LLM ----
LLM_API_KEY=
LLM_MODEL=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Document classification and semantic conflict detection ----
CLASSIFICATION_AUTO_APPROVE_THRESHOLD=0.9
CLASSIFICATION_REQUIRE_ADMIN_APPROVAL_BEFORE_INDEXING=true
SEMANTIC_CONFLICT_DETECTION_ENABLED=true
SEMANTIC_CONFLICT_FAIL_CLOSED=true
SEMANTIC_CONFLICT_MIN_CONFIDENCE=0.75
SEMANTIC_CONFLICT_MAX_CANDIDATES=40
SEMANTIC_CONFLICT_MAX_CHARS_PER_DOCUMENT=48000
SEMANTIC_CONFLICT_SAMPLE_SEGMENTS=5
SEMANTIC_CONFLICT_MAX_FACTS_PER_DOCUMENT=200
SEMANTIC_CONFLICT_MAX_FACT_CHARS_PER_DOCUMENT=32000

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Project image bootstrap ----
PROJECT_IMAGES_BASE_URL=https://pub-2b6dd93e8e8948099737838a9bf56770.r2.dev
PROJECT_IMAGES_ARCHIVE_URL=
AUTO_LOAD_DEMO_DATA=true

# ---- Embedding and document security ----
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_MAX_BYTES=20971520
DOCUMENT_SECURITY_BLOCK_THRESHOLD=high_risk
DOCUMENT_SECURITY_MAX_FINDINGS=20
DOCUMENT_SECURITY_EXCERPT_CONTEXT_CHARS=80

# ---- HYBRID SEARCH (BM25 + RRF) ----
# Reindex existing documents before enabling.
HYBRID_SEARCH_ENABLED=true
SPARSE_MODEL_NAME=Qdrant/bm25
QDRANT_TIMEOUT_SECONDS=5

# ---- RERANKING (Cohere Rerank v3.5) ----
RERANK_ENABLED=true
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
COHERE_RERANK_TIMEOUT_SECONDS=2.5

# ---- CONTEXT SELECTION ----
RAG_MAX_CONTEXT_CHARS=12000
RAG_DUPLICATE_SIMILARITY_THRESHOLD=0.88

# ---- TRACING (eval flywheel) ----
TRACING_ENABLED=true
TRACE_FILE=eval/runs.jsonl
EVALUATION_REPORT_PATH=eval/results/report.json
DEEPEVAL_REPORT_PATH=eval/results/deepeval_report.json
OBSERVABILITY_METRICS_ENABLED=true
TOKEN_INPUT_COST_PER_MILLION_USD=0
TOKEN_OUTPUT_COST_PER_MILLION_USD=0
ADMIN_PRESENCE_WINDOW_MINUTES=15
VERIFIER_THRESHOLD_SALE=0.7

# ---- REFLECTION MEMORY (lessons learned from the agent's own mistakes) ----
REFLECTION_MEMORY_ENABLED=true
REFLECTION_TTL_SECONDS=2592000

# ---- Customer chat (public/anonymous flow, backend/routers/customer_chat.py) ----
CUSTOMER_ANONYMOUS_TURN_LIMIT=3
CUSTOMER_ANONYMOUS_DAILY_LIMIT=3
CUSTOMER_REGISTERED_DAILY_LIMIT=10
ANONYMOUS_RATE_LIMIT_PER_WINDOW=20
ANONYMOUS_RATE_LIMIT_WINDOW_SECONDS=300
# Number of trusted reverse-proxy hops; use 0 for direct access.
TRUSTED_PROXY_COUNT=0

# ---- LEAD CAPTURE & SCORING ----
LEAD_SCORING_ENABLED=true
LEAD_SCORING_LLM_ENABLED=true
LEAD_HOT_THRESHOLD=65
LEAD_WARM_THRESHOLD=35
LEAD_LLM_MIN_TURNS=3
LEAD_LLM_MAX_HISTORY_TURNS=6
LEAD_INBOX_FAIRNESS_MINUTES=10
LEAD_REQUIRE_PHONE_ON_REGISTER=true

# ---- Inventory API (real-time inventory lookup) ----
INVENTORY_API_URL=
INVENTORY_API_KEY=
# Comma-separated slug=code pairs; *=code sets the default.
INVENTORY_PROJECT_MAP=

# ---- Sale-authored, Admin-reviewed news ----
MINIO_BUCKET_NEWS_IMAGES=news-images
NEWS_DEFAULT_TTL_DAYS=180
